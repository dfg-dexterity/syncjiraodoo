# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- Odoo (External API over XML-RPC) ---
# Base URL of your Odoo instance, no trailing slash.
#   SaaS example:        https://mycompany.odoo.com
#   Self-hosted example: https://odoo.example.com
ODOO_URL=https://mycompany.odoo.com
# Database name. On odoo.com this is usually the subdomain (e.g. "mycompany").
ODOO_DB=mycompany
# Login user (email or username).
ODOO_USERNAME=user@example.com
# API key (preferred) or account password.
# Generate an API key in Odoo: Preferences > Account Security > New API Key.
ODOO_API_KEY=your-odoo-api-key

# --- Jira (Atlassian Cloud REST API) ---
# Site base URL, no trailing slash.
JIRA_URL=https://yourcompany.atlassian.net
# Atlassian account email.
JIRA_EMAIL=you@example.com
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
