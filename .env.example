# Copie para .env (que está no .gitignore) e preencha.
# NUNCA comite credenciais reais.

# --- Odoo Online -----------------------------------------------------------
ODOO_URL=https://dexterityit.odoo.com
ODOO_DB=dexterityit
ODOO_USER=usuario@exemplo.com.br
ODOO_API_KEY=coloque-a-chave-de-api-aqui

# --- Jira Cloud (Clockwork grava worklogs nativos do Jira) ------------------
JIRA_URL=https://dexterityit.atlassian.net
JIRA_USER=usuario@exemplo.com.br
# Crie em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=coloque-o-token-aqui

# --- Opcionais ---------------------------------------------------------------
# Sincronizar só estes projetos Jira (vazio = todos):
#JIRA_PROJECT_KEYS=RDF,TAD,FIAG

# Apontar um projeto Jira para um projeto já existente no Odoo (nome exato).
# Projetos fora do mapa são criados/localizados pelo marcador "[KEY]" no nome.
#JIRA_ODOO_PROJECT_MAP={"RDF": "Rotinas Internas"}

# Mapear autor do Jira (accountId ou e-mail) para o e-mail do funcionário no
# Odoo — necessário quando o perfil Atlassian oculta o e-mail.
#JIRA_ODOO_EMPLOYEE_MAP={"712020:3a98a142-...": "diego@dexterityit.com.br"}

# Funcionário usado quando o autor não for resolvido (vazio = pular com aviso):
#DEFAULT_EMPLOYEE_EMAIL=
